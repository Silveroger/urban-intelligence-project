# =============================================================================
# SIH 26124: FastAPI Backend Environment Configuration Template
# Instructions: Copy this file to `backend/.env` and update the placeholder values.
# IMPORTANT: Never commit actual API keys or database passwords to source control.
# =============================================================================

# Server Deployment Stage ('development', 'staging', 'production')
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Supabase Project Credentials
# Found under: Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here
SUPABASE_STORAGE_BUCKET=road-evidence

# -----------------------------------------------------------------------------
# PostgreSQL Database Connection Strings
# Found under: Supabase Dashboard -> Project Settings -> Database -> Connection string
# Note: Use postgresql+asyncpg:// scheme for async driver.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:your_database_password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres:your_database_password@db.your-project-ref.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# PostGIS & Geospatial Settings
# In Supabase, PostGIS extension functions reside in the `gis` schema.
# -----------------------------------------------------------------------------
POSTGIS_SCHEMA=gis
MAP_MATCH_MAX_DISTANCE_METERS=25.0
CONFIDENCE_THRESHOLD=0.50

# -----------------------------------------------------------------------------
# CORS Allowed Origins
# Comma-separated list of allowed frontend dashboard URLs
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
